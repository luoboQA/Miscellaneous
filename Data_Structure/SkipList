// SkipList.hpp
#ifndef SKIP_LIST_HPP
#define SKIP_LIST_HPP


/**
 * @brief 跳表模板（right/down 指针风格）
 * @tparam T 元素类型（必须支持比较操作符 < 和 ==）
 * 
 * 时间复杂度：
 * - 查找：O(log n) 期望
 * - 插入：O(log n) 期望
 * - 删除：O(log n) 期望
 * - 空间复杂度：O(n) 期望
 */
template<typename T>
class SkipList {
private:
    // 节点结构（right/down 风格）
    struct Node {
        T data;
        Node* right;  // 向右指针（同一层）
        Node* down;   // 向下指针（下一层）
        
        Node() : right(nullptr), down(nullptr) {}
        Node(const T& val, Node* right = nullptr, Node* down = nullptr) 
            : data(val), right(right), down(down) {}
        Node(T&& val, Node* right = nullptr, Node* down = nullptr) 
            : data(std::move(val)), right(right), down(down) {}
    };
    
    Node* _head;              // 头节点（哨兵）
    int _maxLevel;           // 当前最大层数
    const int _maxAllowedLevel; // 最大允许层数
    std::size_t _size;       // 元素个数
    double _probability;     // 提升概率
    mutable std::mt19937 _rng;
    std::uniform_real_distribution<double> _dist;
    mutable std::vector<Node*> _path; // 查找路径缓存
    
    /**
     * @brief 随机生成层数
     */
    int randomLevel() const {
        int level = 1;
        while (level < _maxAllowedLevel && _dist(_rng) < _probability) {
            ++level;
        }
        return level;
    }
    
    /**
     * @brief 获取所有层的前驱节点（从上到下）
     */
    void findPath(const T& val, std::vector<Node*>& path) const {
        path.clear();
        Node* p = _head;
        
        while (p) {
            // 向右找到第一个 >= val 的节点的前驱
            while (p->right && p->right->data < val) {
                p = p->right;
            }
            path.push_back(p);
            p = p->down;  // 下降到下一层
        }
    }

public:
    // ---- 构造函数 ----
    
    /**
     * @brief 默认构造函数
     */
    explicit SkipList(int maxAllowedLevel = 16, double probability = 0.5)
        : _maxLevel(1), _maxAllowedLevel(maxAllowedLevel), 
          _size(0), _probability(probability),
          _rng(std::random_device{}()), _dist(0.0, 1.0) {
        if (maxAllowedLevel < 1) {
            throw std::invalid_argument("maxAllowedLevel must be at least 1");
        }
        if (probability <= 0.0 || probability >= 1.0) {
            throw std::invalid_argument("probability must be in (0, 1)");
        }
        _head = new Node();
        _path.reserve(maxAllowedLevel);
    }
    
    /**
     * @brief 从初始化列表构造
     */
    SkipList(std::initializer_list<T> ilist, int maxAllowedLevel = 16, double probability = 0.5)
        : SkipList(maxAllowedLevel, probability) {
        for (const T& val : ilist) {
            insert(val);
        }
    }
    
    /**
     * @brief 从迭代器范围构造
     */
    template<typename InputIt>
    SkipList(InputIt first, InputIt last, int maxAllowedLevel = 16, double probability = 0.5)
        : SkipList(maxAllowedLevel, probability) {
        for (auto it = first; it != last; ++it) {
            insert(*it);
        }
    }
    
    // ---- 析构函数 ----
    
    ~SkipList() {
        clear();
        delete _head;
    }
    
    // ---- 拷贝控制 ----
    
    SkipList(const SkipList& other)
        : _maxLevel(other._maxLevel),
          _maxAllowedLevel(other._maxAllowedLevel),
          _size(0), _probability(other._probability),
          _rng(std::random_device{}()), _dist(0.0, 1.0) {
        _head = new Node();
        _path.reserve(_maxAllowedLevel);
        
        // 遍历 other 并插入所有元素
        for (auto it = other.begin(); it != other.end(); ++it) {
            insert(*it);
        }
    }
    
    SkipList(SkipList&& other) noexcept
        : _head(other._head), _maxLevel(other._maxLevel),
          _maxAllowedLevel(other._maxAllowedLevel),
          _size(other._size), _probability(other._probability),
          _rng(std::move(other._rng)), _dist(0.0, 1.0),
          _path(std::move(other._path)) {
        other._head = nullptr;
        other._size = 0;
        other._maxLevel = 1;
    }
    
    SkipList& operator=(const SkipList& other) {
        if (this != &other) {
            SkipList tmp(other);
            swap(tmp);
        }
        return *this;
    }
    
    SkipList& operator=(SkipList&& other) noexcept {
        if (this != &other) {
            clear();
            delete _head;
            _head = other._head;
            _maxLevel = other._maxLevel;
            _size = other._size;
            _probability = other._probability;
            _rng = std::move(other._rng);
            _path = std::move(other._path);
            other._head = nullptr;
            other._size = 0;
            other._maxLevel = 1;
        }
        return *this;
    }
    
    void swap(SkipList& other) noexcept {
        std::swap(_head, other._head);
        std::swap(_maxLevel, other._maxLevel);
        std::swap(_size, other._size);
        std::swap(_probability, other._probability);
        std::swap(_rng, other._rng);
        std::swap(_path, other._path);
    }
    
    // ---- 容量 ----
    
    std::size_t size() const { return _size; }
    bool empty() const { return _size == 0; }
    int maxLevel() const { return _maxLevel; }
    
    // ---- 查找 ----
    
    /**
     * @brief 查找元素
     */
    bool contains(const T& val) const {
        Node* p = _head;
        
        while (p) {
            // 向右找到第一个 >= val 的节点
            while (p->right && p->right->data < val) {
                p = p->right;
            }
            // 检查当前节点是否为目标值
            if (p->right && p->right->data == val) {
                return true;
            }
            // 下降到下一层
            p = p->down;
        }
        return false;
    }
    
    /**
     * @brief 查找元素并返回引用
     * @throws std::out_of_range 如果元素不存在
     */
    const T& find(const T& val) const {
        Node* p = _head;
        
        while (p) {
            while (p->right && p->right->data < val) {
                p = p->right;
            }
            if (p->right && p->right->data == val) {
                return p->right->data;
            }
            p = p->down;
        }
        throw std::out_of_range("Element not found");
    }
    
    /**
     * @brief 查找小于等于 val 的最大元素
     */
    bool findFloor(const T& val, T& result) const {
        Node* p = _head;
        Node* last = nullptr;
        
        while (p) {
            while (p->right && p->right->data <= val) {
                p = p->right;
            }
            if (p != _head) {
                last = p;
            }
            p = p->down;
        }
        
        if (last) {
            result = last->data;
            return true;
        }
        return false;
    }
    
    /**
     * @brief 查找大于等于 val 的最小元素
     */
    bool findCeil(const T& val, T& result) const {
        Node* p = _head;
        
        while (p) {
            while (p->right && p->right->data < val) {
                p = p->right;
            }
            if (p->right) {
                result = p->right->data;
                return true;
            }
            p = p->down;
        }
        return false;
    }
    
    // ---- 插入 ----
    
    /**
     * @brief 插入元素（如果已存在则不插入）
     */
    bool insert(const T& val) {
        findPath(val, _path);
        
        // 检查是否已存在（在最底层检查）
        if (!_path.empty()) {
            Node* last = _path.back();
            if (last->right && last->right->data == val) {
                return false; // 元素已存在
            }
        }
        
        bool insertUp = true;
        Node* downNode = nullptr;
        
        // 从下往上插入（从最后一层开始）
        while (insertUp && !_path.empty()) {
            Node* prev = _path.back();
            _path.pop_back();
            
            // 创建新节点，插入到 prev 后面
            Node* newNode = new Node(val, prev->right, downNode);
            prev->right = newNode;
            downNode = newNode;
            
            // 50% 概率继续向上插入
            insertUp = (_dist(_rng) < _probability);
        }
        
        // 如果还需要继续往上，但已经到达顶层，则增加新层
        if (insertUp) {
            // 创建新的头节点
            Node* newHead = new Node();
            newHead->down = _head;
            newHead->right = new Node(val, nullptr, downNode);
            _head = newHead;
            ++_maxLevel;
        }
        
        ++_size;
        return true;
    }
    
    /**
     * @brief 插入右值引用版本
     */
    bool insert(T&& val) {
        findPath(val, _path);
        
        if (!_path.empty()) {
            Node* last = _path.back();
            if (last->right && last->right->data == val) {
                return false;
            }
        }
        
        bool insertUp = true;
        Node* downNode = nullptr;
        
        while (insertUp && !_path.empty()) {
            Node* prev = _path.back();
            _path.pop_back();
            
            Node* newNode = new Node(std::move(val), prev->right, downNode);
            prev->right = newNode;
            downNode = newNode;
            
            insertUp = (_dist(_rng) < _probability);
        }
        
        if (insertUp) {
            Node* newHead = new Node();
            newHead->down = _head;
            newHead->right = new Node(std::move(val), nullptr, downNode);
            _head = newHead;
            ++_maxLevel;
        }
        
        ++_size;
        return true;
    }
    
    // ---- 删除 ----
    
    /**
     * @brief 删除元素
     */
    bool erase(const T& val) {
        Node* p = _head;
        bool found = false;
        
        while (p) {
            // 向右找到第一个 >= val 的节点的前驱
            while (p->right && p->right->data < val) {
                p = p->right;
            }
            
            // 如果下一个节点是目标值，删除它
            if (p->right && p->right->data == val) {
                found = true;
                Node* toDelete = p->right;
                p->right = p->right->right;
                delete toDelete;
                // 继续向下层删除
                p = p->down;
            } else {
                // 当前层没有目标值，直接下降到下一层
                p = p->down;
            }
        }
        
        if (found) {
            --_size;
        }
        return found;
    }
    
    /**
     * @brief 删除最小元素
     */
    T popMin() {
        if (empty()) {
            throw std::out_of_range("SkipList is empty");
        }
        // 最底层第一个元素就是最小值
        T minVal = _head->right->data;
        erase(minVal);
        return minVal;
    }
    
    /**
     * @brief 删除最大元素
     */
    T popMax() {
        if (empty()) {
            throw std::out_of_range("SkipList is empty");
        }
        
        // 找到最底层的最后一个元素
        Node* p = _head;
        while (p->down) {
            p = p->down;
        }
        while (p->right) {
            p = p->right;
        }
        T maxVal = p->data;
        erase(maxVal);
        return maxVal;
    }
    
    /**
     * @brief 清空所有元素
     */
    void clear() {
        // 先到达最底层
        Node* bottom = _head;
        while (bottom->down) {
            bottom = bottom->down;
        }
        
        // 从最底层删除所有节点
        Node* current = bottom->right;
        while (current) {
            Node* next = current->right;
            delete current;
            current = next;
        }
        bottom->right = nullptr;
        
        // 删除除最底层外的所有层
        Node* level = _head;
        while (level) {
            Node* nextLevel = level->down;
            // 清除该层的 right 指针（除了头节点）
            level->right = nullptr;
            if (level != _head) {
                delete level;
            }
            level = nextLevel;
        }
        
        // 重置头节点
        _head = new Node();
        _maxLevel = 1;
        _size = 0;
    }
    
    // ---- 范围查询 ----
    
    /**
     * @brief 获取区间 [low, high] 内的所有元素
     */
    std::vector<T> rangeQuery(const T& low, const T& high) const {
        std::vector<T> result;
        if (low > high) return result;
        
        // 找到最底层
        Node* bottom = _head;
        while (bottom->down) {
            bottom = bottom->down;
        }
        
        // 找到第一个 >= low 的节点
        Node* p = bottom;
        while (p->right && p->right->data < low) {
            p = p->right;
        }
        
        p = p->right;
        while (p && p->data <= high) {
            result.push_back(p->data);
            p = p->right;
        }
        
        return result;
    }
    
    /**
     * @brief 获取所有元素（有序）
     */
    std::vector<T> toVector() const {
        std::vector<T> result;
        result.reserve(_size);
        
        // 找到最底层
        Node* bottom = _head;
        while (bottom->down) {
            bottom = bottom->down;
        }
        
        Node* p = bottom->right;
        while (p) {
            result.push_back(p->data);
            p = p->right;
        }
        return result;
    }
    
    // ---- 迭代器支持 ----
    
    class Iterator {
    private:
        Node* _node;
    public:
        using iterator_category = std::forward_iterator_tag;
        using value_type = T;
        using difference_type = std::ptrdiff_t;
        using pointer = T*;
        using reference = T&;
        
        explicit Iterator(Node* node = nullptr) : _node(node) {}
        
        T& operator*() { return _node->data; }
        const T& operator*() const { return _node->data; }
        T* operator->() { return &_node->data; }
        const T* operator->() const { return &_node->data; }
        
        Iterator& operator++() {
            if (_node) _node = _node->right;
            return *this;
        }
        Iterator operator++(int) {
            Iterator tmp = *this;
            ++(*this);
            return tmp;
        }
        
        bool operator==(const Iterator& other) const { return _node == other._node; }
        bool operator!=(const Iterator& other) const { return _node != other._node; }
    };
    
    class ConstIterator {
    private:
        const Node* _node;
    public:
        using iterator_category = std::forward_iterator_tag;
        using value_type = T;
        using difference_type = std::ptrdiff_t;
        using pointer = const T*;
        using reference = const T&;
        
        explicit ConstIterator(const Node* node = nullptr) : _node(node) {}
        ConstIterator(const Iterator& it) : _node(it._node) {}
        
        const T& operator*() const { return _node->data; }
        const T* operator->() const { return &_node->data; }
        
        ConstIterator& operator++() {
            if (_node) _node = _node->right;
            return *this;
        }
        ConstIterator operator++(int) {
            ConstIterator tmp = *this;
            ++(*this);
            return tmp;
        }
        
        bool operator==(const ConstIterator& other) const { return _node == other._node; }
        bool operator!=(const ConstIterator& other) const { return _node != other._node; }
    };
    
    Iterator begin() { 
        Node* bottom = _head;
        while (bottom->down) {
            bottom = bottom->down;
        }
        return Iterator(bottom->right); 
    }
    Iterator end() { return Iterator(nullptr); }
    ConstIterator begin() const { 
        Node* bottom = _head;
        while (bottom->down) {
            bottom = bottom->down;
        }
        return ConstIterator(bottom->right); 
    }
    ConstIterator end() const { return ConstIterator(nullptr); }
    ConstIterator cbegin() const { return begin(); }
    ConstIterator cend() const { return end(); }
    
    // ---- 遍历 ----
    
    void forEach(std::function<void(const T&)> callback) const {
        Node* bottom = _head;
        while (bottom->down) {
            bottom = bottom->down;
        }
        Node* p = bottom->right;
        while (p) {
            callback(p->data);
            p = p->right;
        }
    }
    
    // ---- 静态常量 ----
    static constexpr std::size_t npos = static_cast<std::size_t>(-1);
};

// 非成员 swap
template<typename T>
void swap(SkipList<T>& a, SkipList<T>& b) noexcept {
    a.swap(b);
}

#endif // SKIP_LIST_HPP
